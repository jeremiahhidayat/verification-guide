[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 24
bmc:   mode bmc
bmc:   depth 40
cover: mode cover
cover: depth 60
multiclock off

[engines]
prove: abc pdr
bmc:   smtbmc yices
cover: smtbmc yices

[script]
read -formal fifo.sv
read -formal fifo_formal.sv
prep -top fifo_formal

